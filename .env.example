# توکنِ رباتِ بله (از botFather گرفتید)
BALE_BOT_TOKEN=123456:your-token-here

# محتوایِ کاملِ فایلِ JSONِ کلیدِ سرویسِ Firebase، به‌صورتِ یک‌خطی (نه مسیرِ فایل)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"pardis-b", ...}

# اختیاری: فاصله‌ی زمانیِ بررسیِ پیام‌های تازه (میلی‌ثانیه)
POLL_INTERVAL_MS=15000
