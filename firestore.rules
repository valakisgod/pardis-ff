rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == 'valakisgod@gmail.com';
    }

    // ---- فقط ادمین می‌نویسد؛ همه می‌خوانند ----
    match /listings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /buyers/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /maps/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- هر کاربرِ واردشده (شاملِ ناشناس) می‌نویسد؛ همه می‌خوانند ----
    // events/{main, alarms, notes, contacts, deals, notifications}
    match /events/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ---- «ذخیره‌ها»ی هر کاربر: data/users/<uid>/saved ؛ فقط خودِ همان uid ----
    match /data/users/{uid}/saved {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ---- آگهی‌های خودکارِ بله: خواندنِ عمومی، بدونِ نوشتن از کلاینت (سرویسِ بک‌اند با admin SDK می‌نویسد) ----
    match /bale_listings/{id} {
      allow read: if true;
      allow write: if false;
    }

    // ---- توکنِ اعلانِ گوشی: هر کاربرِ واردشده (شاملِ ناشناس) فقط می‌تونه توکنِ دستگاهِ خودش رو
    //      بسازه/به‌روز/حذف کنه؛ خوندنِ لیستِ توکن‌ها برای هیچ کلاینتی ممکن نیست (فقط سرویسِ بک‌اند) ----
    match /push_tokens/{token} {
      allow read: if false;
      allow create, update: if request.auth != null
          && request.resource.data.keys().hasOnly(['ads', 'alarms', 'updatedAt'])
          && request.resource.data.ads is bool
          && request.resource.data.alarms is bool
          && request.resource.data.updatedAt is string;
      allow delete: if request.auth != null;
    }

    // ---- متادیتای داخلی: کاملاً بسته برای کلاینت (admin SDK قوانین را دور می‌زند) ----
    match /_meta/{document=**} {
      allow read, write: if false;
    }

    // هر چیزِ دیگر: بسته
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
